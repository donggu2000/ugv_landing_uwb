<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_uwb">
    <include merge="true">
      <uri>model://x500_base</uri>
    </include>

    <link name="uwb_tag_link">
      <pose relative_to="base_link">0 0 -0.19 0 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <iyy>0.00002</iyy>
          <izz>0.00002</izz>
        </inertia>
      </inertial>
      <visual name="uwb_tag_body">
        <geometry>
          <box>
            <size>0.10 0.07 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.02 0.20 1.0 1</ambient>
          <diffuse>0.02 0.20 1.0 1</diffuse>
          <specular>0.15 0.15 0.20 1</specular>
        </material>
      </visual>
      <visual name="uwb_tag_led">
        <pose>0.055 0 0.006 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.018</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.0 0.85 1.0 1</ambient>
          <diffuse>0.0 0.85 1.0 1</diffuse>
          <emissive>0.0 0.55 1.0 1</emissive>
        </material>
      </visual>
      <collision name="uwb_tag_collision">
        <geometry>
          <box>
            <size>0.10 0.07 0.035</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="uwb_tag_joint" type="fixed">
      <parent>base_link</parent>
      <child>uwb_tag_link</child>
    </joint>
  </model>
</sdf>
